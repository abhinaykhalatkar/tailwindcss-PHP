parameters:
    level: 8
    # The floor in composer.json (require.php >=8.2): src/ and tools/ are
    # analysed for PHP 8.2, so anything 8.2 lacks is reported here.
    phpVersion: 80200
    paths:
        - src
        - tools
    excludePaths:
        # php-cs-fixer's own manifest and vendor tree, installed by
        # `composer tools:install`; not our code.
        - tools/php-cs-fixer
    treatPhpDocTypesAsCertain: false
