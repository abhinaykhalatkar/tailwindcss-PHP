<?xml version="1.0"?>
<ruleset name="tailwindcss-php">
    <description>PSR-12 coding standard for tailwindcss-php.</description>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>

    <file>src</file>
    <file>tests</file>
    <file>tools</file>
    <file>bin</file>

    <exclude-pattern>vendor</exclude-pattern>
    <!-- php-cs-fixer keeps its own manifest and vendor tree here; not our code. -->
    <exclude-pattern>tools/php-cs-fixer/*</exclude-pattern>
    <!-- Extractor fixtures are real-world Twig/Blade/Vue/JS/JSON samples, not PHP to lint. -->
    <exclude-pattern>tests/Fixtures/*</exclude-pattern>

    <rule ref="PSR12"/>
</ruleset>
