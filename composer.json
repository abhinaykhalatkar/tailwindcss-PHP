{
    "name": "abhinaykhalatkar/tailwindcss-php",
    "description": "Tailwind CSS compiled on demand from PHP with request-time freshness checks and disk caching. No Node, no watcher, works on shared hosting. PHP 7.3+.",
    "type": "library",
    "license": "MIT",
    "keywords": ["tailwind", "tailwindcss", "css", "asset-pipeline", "shared-hosting", "no-node"],
    "homepage": "https://github.com/abhinaykhalatkar/tailwindcss-PHP",
    "support": {
        "issues": "https://github.com/abhinaykhalatkar/tailwindcss-PHP/issues",
        "security": "https://github.com/abhinaykhalatkar/tailwindcss-PHP/security/policy"
    },
    "authors": [{ "name": "abhinay khalatkar" }],
    "require": {
        "php": ">=7.3",
        "ext-json": "*",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/polyfill-php80": "^1.28"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "squizlabs/php_codesniffer": "^3.10 || ^4.0",
        "roave/security-advisories": "dev-latest",
        "scssphp/scssphp": "^1.12 || ^2.0",
        "twig/twig": "^2.16 || ^3.0",
        "psr/http-factory": "^1.0",
        "nyholm/psr7": "^1.8"
    },
    "suggest": {
        "ext-zlib": "Pre-compressed .css.gz artefacts served with Content-Encoding: gzip",
        "ext-apcu": "In-memory check_interval throttle (check_store: apcu)",
        "scssphp/scssphp": "Use an .scss entry file (preprocessor: scss)",
        "twig/twig": "Twig extension providing tailwind_url()",
        "psr/http-factory": "PSR-7 response bridge for frameworks"
    },
    "autoload": {
        "psr-4": { "TailwindPhp\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "TailwindPhp\\Tests\\": "tests/" }
    },
    "bin": ["bin/tailwind-php"],
    "scripts": {
        "test":          "@php vendor/bin/phpunit --testsuite Unit,Integration,Conformance,Security",
        "test:unit":     "@php vendor/bin/phpunit --testsuite Unit",
        "test:coverage": [
            "@php -d pcov.enabled=1 vendor/bin/phpunit --testsuite Unit,Integration,Conformance,Security --coverage-clover build/clover.xml",
            "@php tools/coverage-check.php build/clover.xml"
        ],
        "bench":         "@php -d opcache.enable_cli=1 vendor/bin/phpunit --testsuite Benchmark",
        "stan": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G",
            "@php vendor/bin/phpstan analyse --memory-limit=1G -c phpstan.tests.neon.dist"
        ],
        "tools:install": "@composer install --working-dir=tools/php-cs-fixer --no-interaction",
        "cs": [
            "@php tools/php-cs-fixer/vendor/bin/php-cs-fixer fix --dry-run --diff",
            "@php vendor/bin/phpcs"
        ],
        "cs:fix": [
            "@php tools/php-cs-fixer/vendor/bin/php-cs-fixer fix",
            "@php vendor/bin/phpcbf"
        ],
        "lint:73":       "find src tests tools bin -name '*.php' -print0 2>/dev/null | xargs -0 -n1 php -l",
        "check":         ["@cs", "@stan", "@test"],
        "goldens":       "@php tools/generate-goldens.php",
        "requirements":  "@php tools/requirements-report.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": { "dev-main": "1.x-dev" }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
