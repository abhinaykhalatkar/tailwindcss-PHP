# Analysis of tests/ runs WITHOUT a pinned phpVersion, unlike phpstan.neon.dist.
#
# The test classes extend PHPUnit\Framework\TestCase. Under `phpVersion: 70300`
# PHPStan cannot reflect that class at all — PHPUnit 11's source uses native PHP 8
# union and `mixed` types, and reflection below 8.0.0 semantics fails outright
# (reproduced identically on PHPStan 1.12 and 2.x; 70400 also fails, 80000 passes).
# Every test class then reports `class.notFound` plus follow-on `staticMethod.notFound`,
# which are non-ignorable and say nothing about our own code.
#
# The PHP 8.2 floor for tests/ is therefore enforced by other gates instead:
#   * the 8.2 `php -l` CI job (lint-82),
#   * the 8.2 cells of the CI test matrix (lowest and highest dependencies), and
#   * php-cs-fixer's @PHP82Migration rule set.
#
# src/ keeps its phpVersion pin in phpstan.neon.dist.
parameters:
    level: 8
    paths:
        - tests
    treatPhpDocTypesAsCertain: false
    ignoreErrors: []
    scanDirectories:
        - tools
